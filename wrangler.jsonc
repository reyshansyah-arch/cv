
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "sistem-presensi-wajah",
  "main": "src/index.js",
  "compatibility_date": "2026-11-12",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "presensi_db",
      "database_id": "GANTI_DENGAN_DATABASE_ID_KAMU"
    }
  ]
}
