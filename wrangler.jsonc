{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "presensi_db",
  "main": "index.js",
  "compatibility_date": "2026-11-12",

  "assets": {
    "directory": "./public",
    "binding": "ASSETS"
  },

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "presensi_db",
      "database_id": "cd74ab8b-058f-4690-bdae-1604d75d3c0b"
    }
  ]
}
